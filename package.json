{
  "name": "holyc-wasm",
  "version": "0.1.0",
  "description": "A from-scratch HolyC -> WebAssembly compiler with a TempleOS graphics/sound runtime for the browser.",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:oracle": "node tests/oracle.mjs --check",
    "test:intrinsics": "node src/wasm/emitter.selftest.js && node src/atomic.selftest.mjs && node src/import.selftest.mjs && node tests/atomic-publish.mjs",
    "test:document": "node tests/document.mjs",
    "test:strict": "node tests/strict.mjs",
    "test:callback": "node tests/callback.mjs",
    "test:varargs": "node tests/varargs.mjs",
    "test:format": "node tests/format.mjs",
    "test:console": "node tests/console.mjs",
    "test:exception": "node tests/exception.mjs",
    "test:path-string": "node tests/path-string.mjs",
    "test:alloc-ident": "node tests/alloc-ident.mjs",
    "test:heap": "node tests/heap.mjs",
    "test:runtime-init": "node tests/runtime-init.mjs",
    "test:link": "node tests/link.mjs",
    "test:palette": "node tests/palette.mjs",
    "test:graphics": "node tests/graphics.mjs",
    "test:composites": "node tests/composites.mjs",
    "test:sprite": "node tests/sprite.mjs",
    "test:numeric-runtime": "node tests/numeric-runtime.mjs",
    "test:browser-games": "node tests/browser-games.mjs",
    "test:float-scale": "node tests/oracle-scale.mjs",
    "test:core": "node tests/core.mjs",
    "test:messages": "node tests/messages.mjs",
    "test:tasks": "node tests/tasks.mjs",
    "test:tasks-browser": "node tests/tasks-browser.mjs",
    "test:keyboard": "node tests/keyboard.mjs && node tests/key-protocol.mjs",
    "test:window": "node tests/window.mjs && node tests/document-lock.mjs",
    "test:char": "node tests/char.mjs",
    "test:break": "node tests/break.mjs",
    "test:fifo": "node tests/fifo.mjs",
    "test:global-binding": "node tests/global-binding.mjs && NOFOLD=1 node tests/global-binding.mjs",
    "test:font-address": "node tests/font-address.mjs && NOFOLD=1 node tests/font-address.mjs",
    "test:raw": "node tests/raw.mjs && node tests/raw-lifetime.mjs",
    "test:files": "node tests/files.mjs && node tests/files-fault.mjs && node tests/files-limit.mjs && node tests/file-api.mjs && node tests/file-fault.mjs && node tests/file-volume.mjs",
    "test:keydev": "node tests/keydev.mjs && node tests/keydev-fault.mjs",
    "test:hash": "node tests/hash.mjs && node tests/hash-fault.mjs",
    "test:doc-entry": "node tests/doc-entry.mjs && node tests/doc-copy-fault.mjs && node tests/doc-insert-fault.mjs && node tests/doc-foreign-fault.mjs",
    "test:define": "node tests/define.mjs && node tests/define-fault.mjs",
    "test:cmp-control": "node tests/cmp-control.mjs && node tests/cmp-control-fault.mjs"
  },
  "license": "MIT",
  "author": "Built with Claude Code"
}

U0 ParseTest()
{
  CDoc *doc=CAlloc(sizeof(CDoc));
  CDocEntry *entry;
  I64 i;
  parse_hash=0xCBF29CE484222325;parse_count=0;
  doc->mem_task=Fs;
  for (i=0;i<210;i++) {
    entry=PrsDollarCmd(doc,parse_commands[i]);
    ParseState(entry);
    "Case:%d:%d:%016X\n",i,entry->type_u8,parse_hash;
    ParseFree(entry);
  }
  Free(doc);
  "Parse:%016X:%d\n",parse_hash,parse_count;
}
ParseTest;

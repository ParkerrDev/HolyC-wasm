U0 FunctionExports()
{
  U8 *ptr=bind_export_names;
  CHashExport *tmpex;
  CHashFun *tmpf;
  while (*ptr) {
    if (tmpex=HashFind(ptr,Fs->hash_table,HTT_EXPORT_SYS_SYM)) {
      tmpf=HashFind(ptr,Fs->hash_table,HTT_FUN);
      "Export:%s:%d:%d\n",ptr,!!tmpf,!!tmpf && tmpf->exe_addr==tmpex->val;
    }
    ptr+=StrLen(ptr)+1;
  }
}

FunctionExports;

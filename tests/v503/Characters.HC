I64 char_codes[26]={CH_CTRLA,CH_CTRLB,CH_CTRLC,CH_CTRLD,CH_CTRLE,
	CH_CTRLF,CH_CTRLG,CH_CTRLH,CH_CTRLI,CH_CTRLJ,CH_CTRLK,CH_CTRLL,
	CH_CTRLM,CH_CTRLN,CH_CTRLO,CH_CTRLP,CH_CTRLQ,CH_CTRLR,CH_CTRLS,
	CH_CTRLT,CH_CTRLU,CH_CTRLV,CH_CTRLW,CH_CTRLX,CH_CTRLY,CH_CTRLZ};

U0 Characters()
{
  I64 i;
  "%X %X %X %X %X\n",CH_CURSOR,CH_BACKSPACE,CH_ESC,
	CH_SHIFT_ESC,CH_SHIFT_SPACE;
  for (i=0;i<26;i++) "%X ",char_codes[i];
  "\n";
}

Characters;

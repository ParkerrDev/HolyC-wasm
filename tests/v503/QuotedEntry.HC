//V5.03 Lex keeps a doc entry inside a string as its text between dollars
//(Compiler/Lex.HC LexDollar), as Demo/RandDemo.HC prints a link.
U0 Quoted()
{
  U8 *s="a $LK,"Seed(0)",A="FF:::/Kernel/KTask.HC,Seed("$ b";
  I64 i;
  "%d\n",StrLen(s);
  for (i=0;s[i];i++)
    "%d ",s[i];
  '\n';
}

Quoted;
